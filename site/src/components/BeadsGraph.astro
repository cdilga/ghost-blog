---
/**
 * A project's real beads dependency graph, laid out by blocking depth (left = no blockers).
 * Data from scripts/beads-graph.py (structure only, no titles). <BeadsGraph data={json} title caption />
 */
const { data, title = '', caption = '', height = 360 } = Astro.props;
const W = 760, H = height, m = { l: 14, r: 14, t: 16, b: 26 };
const iw = W - m.l - m.r, ih = H - m.t - m.b;
const L = Math.max(1, data.layers - 1);
const x = (n) => m.l + (n.l / L) * iw;
const y = (n) => m.t + n.p * ih;
const fill = { closed: '#ff7a1a', in_progress: '#ffd166', blocked: '#ff6b6b', open: 'none', deferred: 'none' };
const stroke = { closed: '#ff7a1a', in_progress: '#ffd166', blocked: '#ff6b6b', open: '#f2e6d3', deferred: 'rgba(185,166,143,.5)' };
const label = { closed: 'closed', in_progress: 'in progress', blocked: 'blocked', open: 'open', deferred: 'deferred' };
const present = Object.keys(label).filter((s) => data.status[s]);
const f1 = (v) => v.toFixed(1);
const paths = data.edges.map(([a, b]) => {
  const A = data.nodes[a], B = data.nodes[b];
  const x1 = x(A), y1 = y(A), x2 = x(B), y2 = y(B), cx = (x1 + x2) / 2;
  return `M${f1(x1)},${f1(y1)} C${f1(cx)},${f1(y1)} ${f1(cx)},${f1(y2)} ${f1(x2)},${f1(y2)}`;
}).join(' ');
---
<figure class="chart wide beadsgraph">
  {title && <h3 style="margin:0 0 6px;font-size:1rem">{title}</h3>}
  <div class="legend">{present.map((s) => <span><i style={`background:${fill[s] === 'none' ? 'transparent' : fill[s]};border:1.5px solid ${stroke[s]}`}></i>{label[s]} {data.status[s]}</span>)}</div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}: ${data.beads} beads, ${data.blocks} blocking links, ${data.layers} layers deep`}>
    <g fill="none" stroke="rgba(242,230,211,.11)" stroke-width="0.8">
      <path d={paths} />
    </g>
    {data.nodes.map((n) => <circle cx={x(n).toFixed(1)} cy={y(n).toFixed(1)} r={n.t === 'epic' ? 5 : 3.2} fill={fill[n.s] ?? 'none'} stroke={stroke[n.s] ?? '#f2e6d3'} stroke-width="1.3" />)}
    <text x={m.l} y={H - 6}>no blockers</text>
    <text x={W - m.r} y={H - 6} text-anchor="end">{data.layers} layers deep</text>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
