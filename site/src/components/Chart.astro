---
/**
 * Build-time SVG chart. Zero client JS, themable, readable in dark/light.
 * <Chart type="line" series={[{ name, data: [[x,y],...] }]} xLabel yLabel logX logY caption />
 * type: line | bar (bar uses string x values) | scatter
 */
const { type = 'line', series = [], xLabel = '', yLabel = '', logX = false, logY = false, caption = '', title = '', yMin, yMax, xMarks = [], height = 320 } = Astro.props;
const colours = ['#ff7a1a', '#5ec8c0', '#b48cff', '#f2e6d3', '#ffd166'];
const W = 760, H = height, m = { l: 56, r: 18, t: 14, b: 46 };
const iw = W - m.l - m.r, ih = H - m.t - m.b;
const cat = type === 'bar';
const cats = cat ? [...new Set(series.flatMap((s) => s.data.map((d) => d[0])))] : [];
const xs = series.flatMap((s) => s.data.map((d) => (cat ? 0 : d[0])));
const ys = series.flatMap((s) => s.data.map((d) => d[1]));
const tf = (v, log) => (log ? Math.log10(v) : v);
let x0 = cat ? 0 : Math.min(...xs.map((v) => tf(v, logX))), x1 = cat ? 1 : Math.max(...xs.map((v) => tf(v, logX)));
let y0 = yMin ?? (type === 'bar' || logY ? Math.min(...ys.map((v) => tf(v, logY))) : Math.min(0, ...ys)), y1 = yMax ?? Math.max(...ys.map((v) => tf(v, logY)));
if (type === 'bar' && !logY) y0 = Math.min(0, y0);
if (y1 === y0) y1 = y0 + 1;
const nice = (a, b, n = 5) => { const step = (b - a) / n; const p = Math.pow(10, Math.floor(Math.log10(step))); const f = step / p; const s = (f < 1.5 ? 1 : f < 3 ? 2 : f < 7 ? 5 : 10) * p; const t = []; for (let v = Math.ceil(a / s) * s; v <= b + 1e-9; v += s) t.push(+v.toPrecision(12)); return t; };
const logTicks = (a, b) => { const t = []; for (let e = Math.ceil(a); e <= Math.floor(b); e++) t.push(e); return t; };
const yt = logY ? logTicks(y0, y1) : nice(y0, y1);
const xt = cat ? [] : logX ? logTicks(x0, x1) : nice(x0, x1, 6);
if (!logY) { y0 = Math.min(y0, yt[0] ?? y0); y1 = Math.max(y1, yt[yt.length - 1] ?? y1); }
const sx = (v) => m.l + ((tf(v, logX) - x0) / (x1 - x0 || 1)) * iw;
const sy = (v) => m.t + ih - ((tf(v, logY) - y0) / (y1 - y0)) * ih;
const fmt = (v, log) => { const n = log ? Math.pow(10, v) : v; return Math.abs(n) >= 1000 || (Math.abs(n) < 0.01 && n !== 0) ? n.toExponential(0) : +n.toPrecision(3) + ''; };
const bw = cat ? iw / cats.length : 0;
const gw = cat ? (bw * 0.78) / series.length : 0;
---
<figure class="chart wide" role="figure" aria-label={title || caption} data-interactive={type === 'line' ? JSON.stringify({ m, iw, ih, W, H, x0, x1, logX, colours, series: series.map((s) => ({ name: s.name, pts: s.data.map((d) => [d[0], d[1], sx(d[0]), sy(d[1])]) })) }) : undefined}>
  {title && <h3 style="margin:0 0 6px;font-size:1rem">{title}</h3>}
  {series.length > 1 && <div class="legend">{series.map((s, i) => <span><i style={`background:${colours[i % colours.length]}`}></i>{s.name}</span>)}</div>}
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title || caption}>
    {yt.map((v) => <g><line class="grid" x1={m.l} x2={W - m.r} y1={m.t + ih - ((v - y0) / (y1 - y0)) * ih} y2={m.t + ih - ((v - y0) / (y1 - y0)) * ih} /><text x={m.l - 8} y={m.t + ih - ((v - y0) / (y1 - y0)) * ih + 4} text-anchor="end">{fmt(v, logY)}</text></g>)}
    {xt.map((v) => <g><line class="grid" y1={m.t} y2={m.t + ih} x1={m.l + ((v - x0) / (x1 - x0)) * iw} x2={m.l + ((v - x0) / (x1 - x0)) * iw} /><text x={m.l + ((v - x0) / (x1 - x0)) * iw} y={H - m.b + 18} text-anchor="middle">{fmt(v, logX)}</text></g>)}
    {cat && cats.map((c, i) => <text x={m.l + bw * (i + 0.5)} y={H - m.b + 18} text-anchor="middle">{c}</text>)}
    <line class="axis" x1={m.l} x2={W - m.r} y1={m.t + ih} y2={m.t + ih} /><line class="axis" x1={m.l} x2={m.l} y1={m.t} y2={m.t + ih} />
    {xMarks.map((mk) => <g><line x1={sx(mk.x)} x2={sx(mk.x)} y1={m.t} y2={m.t + ih} stroke="#ffd166" stroke-dasharray="4 4" stroke-opacity=".7" /><text x={sx(mk.x) + 5} y={m.t + 12} style="fill:#ffd166">{mk.label}</text></g>)}
    {series.map((s, si) => {
      const col = colours[si % colours.length];
      if (cat) return s.data.map((d) => { const i = cats.indexOf(d[0]); const y = sy(d[1]); const base = sy(logY ? Math.pow(10, y0) : 0); return <rect x={m.l + bw * i + bw * 0.11 + gw * si} y={Math.min(y, base)} width={gw - 2} height={Math.abs(base - y)} rx="3" fill={col}><title>{`${s.name}: ${d[0]} = ${d[1]}`}</title></rect>; });
      const pts = s.data.map((d) => [sx(d[0]), sy(d[1])]);
      return <g>
        {type === 'line' && <path d={pts.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join('')} fill="none" stroke={col} stroke-width="2.5" stroke-linejoin="round" />}
        {(type === 'scatter' || !(s.data.length > 14)) && pts.map((p, i) => <circle class="pt" cx={p[0]} cy={p[1]} r="4" fill={col}><title>{`${s.name}: ${s.data[i][0]}, ${s.data[i][1]}`}</title></circle>)}
      </g>;
    })}
    <text x={m.l + iw / 2} y={H - 6} text-anchor="middle">{xLabel}</text>
    <text transform={`translate(14 ${m.t + ih / 2}) rotate(-90)`} text-anchor="middle">{yLabel}</text>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
  // Hover / touch readout for line charts: a crosshair snaps to the nearest x and lists every series' value.
  for (const fig of document.querySelectorAll<HTMLElement>('figure.chart[data-interactive]')) {
    if (fig.dataset.wired) continue; fig.dataset.wired = '1';
    const cfg = JSON.parse(fig.dataset.interactive!);
    const svg = fig.querySelector('svg')!;
    const NS = 'http://www.w3.org/2000/svg';
    const g = document.createElementNS(NS, 'g'); g.style.display = 'none'; g.setAttribute('pointer-events', 'none');
    const line = document.createElementNS(NS, 'line'); line.setAttribute('y1', cfg.m.t); line.setAttribute('y2', cfg.m.t + cfg.ih); line.setAttribute('stroke', 'rgba(242,230,211,.35)');
    g.append(line);
    const dots = cfg.series.map((_: unknown, i: number) => { const c = document.createElementNS(NS, 'circle'); c.setAttribute('r', '5'); c.setAttribute('fill', cfg.colours[i % cfg.colours.length]); c.setAttribute('stroke', '#120d0a'); c.setAttribute('stroke-width', '2'); g.append(c); return c; });
    svg.append(g);
    const tip = document.createElement('div'); tip.className = 'chart-tip'; tip.hidden = true; fig.style.position = 'relative'; fig.append(tip);
    const xsAll = [...new Set(cfg.series.flatMap((s: any) => s.pts.map((p: number[]) => p[2])))].sort((a: any, b: any) => a - b) as number[];
    function show(ev: PointerEvent) {
      const r = svg.getBoundingClientRect();
      const vx = ((ev.clientX - r.left) / r.width) * cfg.W;
      let best = xsAll[0]; for (const x of xsAll) if (Math.abs(x - vx) < Math.abs(best - vx)) best = x;
      line.setAttribute('x1', String(best)); line.setAttribute('x2', String(best));
      const rows: string[] = []; let xv: number | null = null;
      cfg.series.forEach((s: any, i: number) => {
        const p = s.pts.find((q: number[]) => Math.abs(q[2] - best) < 0.01);
        if (!p) { dots[i].style.display = 'none'; return; }
        dots[i].style.display = ''; dots[i].setAttribute('cx', p[2]); dots[i].setAttribute('cy', p[3]); xv = p[0];
        rows.push(`<span><i style="background:${cfg.colours[i % cfg.colours.length]}"></i>${s.name}: <b>${+(+p[1]).toPrecision(4)}</b></span>`);
      });
      g.style.display = '';
      tip.innerHTML = `<small>${xv}</small>${rows.join('')}`; tip.hidden = false;
      const fr = fig.getBoundingClientRect();
      const px = (best / cfg.W) * r.width + r.left - fr.left;
      const left = px + 14 + tip.offsetWidth > fig.clientWidth - 8 ? px - 14 - tip.offsetWidth : px + 14;
      tip.style.left = `${Math.max(8, left)}px`; tip.style.top = `${r.top - fr.top + 8}px`;
    }
    svg.addEventListener('pointermove', show); svg.addEventListener('pointerdown', show);
    svg.addEventListener('pointerleave', () => { g.style.display = 'none'; tip.hidden = true; });
  }
</script>
