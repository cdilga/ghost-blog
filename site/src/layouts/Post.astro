---
import Base from './Base.astro';
const { title, description, date, tags = [], image, legacy = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (p) => (p && p.startsWith('/') ? `${base}${p}` : p);
---
<Base title={`${title} | Chris Dilger`} description={description}>
  <article class="prose">
    <p class="meta"><a href={`${base}/blog/`}>← Writing</a>{date && <> · {date.toISOString().slice(0, 10)}</>}{tags.length ? ' · ' + tags.join(', ') : ''}{legacy && <> · <span class="archive-flag">Archive</span></>}</p>
    <h1>{title}</h1>
    {image && <figure class="feature"><img src={src(image)} alt="" loading="eager" decoding="async" /></figure>}
    <slot />
  </article>
  <footer class="foot">© Chris Dilger</footer>
</Base>
