---
import Footer from '../components/Footer.astro';
import Base from './Base.astro';
const { title, description, date, tags = [], image, legacy = false, draft = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const src = (p) => (p && p.startsWith('/') ? `${base}${p}` : p);
---
<Base title={`${title} | Chris Dilger`} description={description} image={image ?? '/og-default.jpg'} imageAlt={image ? title : undefined} type="article" published={date} noindex={draft}>
  <article class="prose">
    <p class="meta"><a href={`${base}/blog/`}>← Writing</a>{date && <> · <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time></>}{tags.map((t, i) => <>{i ? ', ' : ' · '}<a href={`${base}/blog/tag/${slug(t)}/`}>{t}</a></>)}{legacy && <> · <span class="archive-flag">Archive</span></>}{draft && <> · <span class="archive-flag">Draft</span></>}</p>
    <h1>{title}</h1>
    {image && <figure class="feature"><img src={src(image)} alt="" loading="eager" decoding="async" /></figure>}
    <slot />
  </article>
  <Footer />
</Base>
