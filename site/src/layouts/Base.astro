---
import '../styles/global.css';
const { intro = false, title = 'Chris Dilger', description = 'Chris Dilger builds software with a fleet of AI agents: games, tools and a digital twin of a house.', image = '/desert.jpg', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = image && !/^https?:/.test(image) ? new URL(`${base}${image}`, Astro.site).href : image;
---
<!doctype html>
<html lang="en-AU" class="no-js" data-intro={intro ? 'manual' : undefined}>
<head>
  <meta charset="utf-8" />
  <!-- black from the first byte: the page fades in once it is ready, however slow the connection -->
  <style is:inline>html,body{background:#000}#curtain{position:fixed;inset:0;z-index:2147483000;background:#000;pointer-events:none}</style>
  <noscript><style is:inline>#curtain{display:none}</style></noscript>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#120d0a" />
  <meta name="base" content={base} />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="alternate" type="application/rss+xml" title="Chris Dilger" href={`${base}/rss.xml`} />
</head>
<body>
  <div id="curtain" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>
  <header class="bar">
    <a href={`${base}/`}>Chris Dilger</a>
    <nav aria-label="Primary">
      <a href={`${base}/#projects`}>Projects</a>
      <a href={`${base}/blog/`}>Writing</a>
      <a class="icon-link" href="https://github.com/cdilga" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span>GitHub</span></a>
      <a class="icon-link" href="https://linkedin.com/in/cdilga" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M0 1.15C0 .52.52 0 1.18 0h13.64C15.48 0 16 .52 16 1.15v13.7c0 .63-.52 1.15-1.18 1.15H1.18C.52 16 0 15.48 0 14.85V1.15Zm4.94 12.24V6.17H2.54v7.22h2.4ZM3.74 5.18c.84 0 1.36-.55 1.36-1.25-.02-.71-.52-1.25-1.34-1.25-.82 0-1.36.54-1.36 1.25 0 .7.52 1.25 1.33 1.25h.01Zm4.91 8.21V9.36c0-.22.02-.43.08-.59.17-.43.57-.88 1.23-.88.87 0 1.22.66 1.22 1.64v3.86h2.4V9.25c0-2.22-1.18-3.25-2.76-3.25-1.27 0-1.84.7-2.16 1.19v.02h-.02l.02-.02V6.17h-2.4c.03.68 0 7.22 0 7.22h2.4Z"/></svg><span>LinkedIn</span></a>
      <button type="button" class="search-btn" data-search-open aria-label="Search the site (press /)" title="Search (/)"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>Search</span><kbd>/</kbd></button>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <script>import '../scripts/search.js';</script>
  <script is:inline>
    // Lift the black curtain. Text pages: once fonts are in (2.5 s cap). The home page lifts it itself when the
    // desert has loaded; this is only its safety net, so a script failure can never leave the page black.
    (function () {
      var c = document.getElementById('curtain'); if (!c) return;
      var manual = document.documentElement.dataset.intro === 'manual', done = false;
      function lift() { if (done || !c.isConnected || c.dataset.lifting) return; done = true; c.style.transition = 'opacity .5s ease'; c.style.opacity = '0'; setTimeout(function () { c.remove(); }, 560); }
      if (manual) { setTimeout(lift, 16000); return; }
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(lift);
      setTimeout(lift, 2500);
    })();
  </script>
</body>
</html>
