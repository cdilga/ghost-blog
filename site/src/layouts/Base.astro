---
import '../styles/global.css';
const { title = 'Chris Dilger', description = 'Chris Dilger builds software with a fleet of AI agents: games, tools and a digital twin of a house.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en-AU" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#120d0a" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="alternate" type="application/rss+xml" title="Chris Dilger" href={`${base}/rss.xml`} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="bar">
    <a href={`${base}/`}>Chris Dilger</a>
    <nav aria-label="Primary">
      <a href={`${base}/#projects`}>Projects</a>
      <a href={`${base}/blog/`}>Writing</a>
      <a href="https://github.com/cdilga">GitHub</a>
    </nav>
  </header>
  <main id="main"><slot /></main>
</body>
</html>
