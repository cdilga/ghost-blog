---
// The old Ghost /contact/ page now lives on the home page.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/#contact`;
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <title>Contact | Chris Dilger</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={new URL(to, Astro.site)} />
  <meta http-equiv="refresh" content={`0;url=${to}`} />
</head>
<body><p>This page has moved to <a href={to}>the contact section</a>.</p></body>
</html>
