---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPosts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const img = (p) => (p ? `${base}${p}` : '');

// Scene lengths are in viewport-heights of scroll. Total drives the track height in CSS.
const scenes = [
  { id: 'top', label: 'Start', len: 1.1 },
  { id: 'story', label: 'How I got here', len: 2.4 },
  { id: 'plan', label: 'Plan with beads', len: 1.5 },
  { id: 'fleet', label: 'A fleet of agents', len: 1.8 },
  { id: 'facemorph', label: 'facemorph.me', len: 1.35 },
  { id: 'projects', label: 'Physical Soccer', len: 1.25 },
  { id: 'jammers', label: 'Joystick Jammers', len: 1.25 },
  { id: 'books', label: 'Aviation ABCs', len: 1.25 },
  { id: 'dishmate', label: 'Dishmate', len: 1.15 },
  { id: 'home', label: 'Home twin', len: 1.5 },
  { id: 'writing', label: 'Writing', len: 2.2 },
  { id: 'contact', label: 'Say hello', len: 0.9 },
];
const total = scenes.reduce((a, s) => a + s.len, 0);
const S = (id) => scenes.find((s) => s.id === id);

const beads = [
  { id: 'bd-12', t: 'Lobby + QR join', x: 20, y: 30, done: 0.12 },
  { id: 'bd-13', t: 'Phone as joystick', x: 20, y: 120, done: 0.2 },
  { id: 'bd-14', t: 'Race physics', x: 250, y: 75, done: 0.38 },
  { id: 'bd-15', t: 'Demolition mode', x: 480, y: 30, done: 0.55 },
  { id: 'bd-16', t: 'Playtest round', x: 480, y: 120, done: 0.68 },
  { id: 'bd-17', t: 'Ship build', x: 710, y: 75, done: 0.85 },
];
// The development story, oldest first. Links go to the archived posts from each era.
const timeline = [
  { year: 2018, era: 'University', title: 'Evolutionary algorithms', body: 'Studying at Swinburne. My first research write-up: a genetic algorithm that reduces data sets without losing what matters.', href: '/blog/data-reduction-efficency/' },
  { year: 2018, era: 'Abroad', title: 'Sarawak, Brunei, Boston', body: 'A social innovation project in Kampung Stutong Baru, then an exchange to Northeastern. Learning to build for people who are not me.', href: '/blog/social-innovation-project/' },
  { year: 2019, era: 'Hackathons', title: 'Checkface', body: 'We turned hash checking into something your brain does for free: a hash becomes a generated face you recognise at a glance. It grew into facemorph.me.', href: '/blog/checkface/' },
  { year: 2020, era: 'Teaching', title: 'Explaining things', body: 'Data engineering bootcamps and plain-English explainers like "What is an API?". Teaching is how I check I actually understand something.', href: '/blog/what-is-an-api/' },
  { year: 2021, era: 'Measuring', title: 'M1 vs i7 4790k', body: 'Benchmarking a new Mac against an old desktop, published in English and Chinese. Opinions are cheap, numbers are better.', href: '/blog/new-mac-m1-or-old-intel-i7-4790k-which-would-win/' },
  { year: 2023, era: 'Consulting', title: 'Data and platforms', body: 'Data engineering and consulting for teams who need systems that keep working after the consultant leaves.' },
  { year: 2025, era: 'Agents', title: 'Claude in a loop', body: 'continuous-claude: an agent running unattended, opening pull requests while I sleep. The bottleneck moved from typing to deciding.', href: 'https://github.com/cdilga/continuous-claude' },
  { year: 2026, era: 'Now', title: 'Post SaaS, not prompts', body: 'Plans live as beads, a herd of agents builds, I steer. Games, a book, a house twin, all shipping in parallel.', href: '/blog/your-prompts-do-not-matter-anymore/' },
];
const edges = [[0, 2], [1, 2], [2, 3], [2, 4], [3, 5], [4, 5]];
const term = [
  ['claude-1', 'bd-12 lobby + QR join', 'tests green'],
  ['claude-2', 'bd-13 phone as joystick', 'tilt calibration'],
  ['codex-3', 'bd-14 race physics', 'tuning grip curve'],
  ['claude-4', 'bd-15 demolition', 'collision damage'],
  ['claude-5', 'bd-16 playtest notes', 'summarising round 22'],
  ['claude-6', 'bd-21 books checkout', 'stripe sandbox ok'],
  ['codex-7', 'bd-30 house model', 'rebuilding stage: frame'],
  ['claude-8', 'bd-31 blog charts', 'plotting jet decay'],
];
---
<Base title="Chris Dilger | Building with a fleet of agents">
<div class="story" id="story" data-total={total} style={`--total:${total}`}>
  <div class="stage">
    <canvas id="depth" class="depth" aria-hidden="true"></canvas>
    <div class="progress" id="progress"></div>
    <div class="frame">
      <div class="motion-ui mono" id="motion-ui" hidden>
        <span class="mu-src">moving with <b data-o="src">scroll</b></span>
        <button type="button" data-i="tilt" hidden>tilt to look around</button>
        <button type="button" data-i="camera" hidden>use camera</button>
        <button type="button" data-i="info" hidden aria-label="What the camera sees">?</button>
        <div class="mu-panel" hidden><canvas width="32" height="32"></canvas><p>This is everything the camera code sees: a 32 by 32 pixel edge image, compared frame to frame to estimate how your head moved. Nothing is stored or sent anywhere.</p></div>
      </div>
      <nav class="rail" id="rail" aria-label="Sections">
        {scenes.map((s) => <button type="button" data-goto={s.id} aria-label={s.label}><span>{s.label}</span></button>)}
      </nav>

      <!-- 0. HERO -->
      <section class="scene" data-scene="top" data-bg="a" data-bg-dim=".22" data-len={S('top').len} aria-label="Introduction">
        <div class="bg photo" data-fx="bgzoom"><img src={`${base}/bg/dune.jpg`} alt="" style="width:100%;height:100%;object-fit:cover;filter:brightness(.5) saturate(1.1)" /></div>
        <div class="bg" style="background:radial-gradient(120% 90% at 30% 30%, transparent 30%, var(--ink) 95%)"></div>
        <div class="beadfield" aria-hidden="true"><i data-fx="drift" data-speed="160" style="left:8%;top:22%;width:12px;height:12px"></i><i data-fx="drift" data-speed="90" style="left:18%;top:70%;width:8px;height:8px"></i><i data-fx="drift" data-speed="260" style="left:27%;top:38%;width:18px;height:18px"></i><i data-fx="drift" data-speed="120" style="left:41%;top:82%;width:10px;height:10px"></i><i data-fx="drift" data-speed="70" style="left:55%;top:15%;width:6px;height:6px"></i><i data-fx="drift" data-speed="200" style="left:63%;top:60%;width:14px;height:14px"></i><i data-fx="drift" data-speed="110" style="left:72%;top:30%;width:8px;height:8px"></i><i data-fx="drift" data-speed="300" style="left:81%;top:76%;width:20px;height:20px"></i><i data-fx="drift" data-speed="150" style="left:88%;top:45%;width:10px;height:10px"></i><i data-fx="drift" data-speed="80" style="left:94%;top:18%;width:6px;height:6px"></i><i data-fx="drift" data-speed="180" style="left:35%;top:90%;width:12px;height:12px"></i><i data-fx="drift" data-speed="60" style="left:12%;top:48%;width:6px;height:6px"></i><i data-fx="drift" data-speed="140" style="left:50%;top:55%;width:8px;height:8px"></i><i data-fx="drift" data-speed="220" style="left:76%;top:90%;width:10px;height:10px"></i></div>
        <div class="content">
          <p class="kicker" data-fx="fade" data-a="0" data-d=".12">Chris Dilger · software engineer</p>
          <h1 class="big" data-fx="words" data-a=".02" data-d=".4">I plan in beads and ship with a fleet of agents.</h1>
          <p class="lede" data-fx="reveal" data-a=".3" data-d=".36">Games you play with your phone, a book printed to order, and a digital twin of a house. Scroll for how it gets built.</p>
          <a class="cta" data-fx="rise" data-a=".4" data-d=".2" href="#projects">See the projects</a>
          <a class="cta ghost" data-fx="rise" data-a=".45" data-d=".2" href={`${base}/blog/`}>Read the writing</a>
        </div>
        <div class="cue mono" data-fx="out" data-a=".05" data-d=".2" aria-hidden="true">scroll<i></i></div>
      </section>

      <!-- 0b. STORY: how I got here -->
      <section class="scene" data-scene="story" data-bg="a" data-bg-dim=".72" data-len={S('story').len} aria-label="How I got here">
        <div class="content tl" data-hook="timeline">
          <div class="tl-head">
            <p class="kicker" data-fx="fade" data-a="0" data-d=".06">How I got here</p>
            <h2 class="mid" data-fx="words" data-a=".0" data-d=".12">From one algorithm to a herd of agents.</h2>
          </div>
          <div class="tl-year mono" aria-hidden="true">2018</div>
          <div class="tl-rule" aria-hidden="true"><i class="tl-fill"></i></div>
          <ol class="tl-track">
            {timeline.map((m) => (
              <li class="tl-item" data-year={m.year}>
                <small class="mono">{m.year} · {m.era}</small>
                <h3>{m.href ? <a href={m.href.startsWith('/') ? `${base}${m.href}` : m.href}>{m.title}</a> : m.title}</h3>
                <p>{m.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 1. PLAN: beads -->
      <section class="scene" data-scene="plan" data-bg="a>b" data-bg-dim=".62" data-len={S('plan').len} aria-label="Planning with beads">
        <div class="content">
          <p class="kicker" data-fx="fade" data-a="0" data-d=".1">01 · Plan</p>
          <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">Every idea becomes a bead first.</h2>
          <p class="lede" data-fx="reveal" data-a=".15" data-d=".36"><b>Beads</b> is an issue tracker that lives in git, with real dependencies. <code class="mono">bd ready</code> lists what is unblocked, so any agent can pick up the next piece without me explaining the plan again.</p>
          <p class="stat mono" data-fx="rise" data-a=".1" data-d=".1"><span data-ready>0</span> ready to claim</p>
          <svg class="graph" viewBox="0 0 900 190" role="img" aria-label="A dependency graph of tasks being completed" data-hook="beads" style="margin-top:20px">
            {edges.map(([a, b], i) => {
              const A = beads[a], B = beads[b];
              return <path class="edge" pathLength="1" data-i={i} data-from={a} data-to={b} d={`M${A.x + 160},${A.y + 22} C${A.x + 205},${A.y + 22} ${B.x - 45},${B.y + 22} ${B.x},${B.y + 22}`} />;
            })}
            {beads.map((b, i) => (
              <g class="node" data-i={i} data-done={b.done} transform={`translate(${b.x},${b.y})`}>
                <rect width="160" height="44" rx="8" />
                <text class="id" x="12" y="17">{b.id}</text>
                <text x="12" y="34">{b.t}</text>
              </g>
            ))}
          </svg>
        </div>
      </section>

      <!-- 2. FLEET: herdr / ntm -->
      <section class="scene" data-scene="fleet" data-bg="b" data-bg-dim=".6" data-len={S('fleet').len} aria-label="A fleet of agents">
        <div class="crt-black" aria-hidden="true"></div><div class="crt-line" aria-hidden="true"></div>
        <div class="content"><div class="crt-screen" data-hook="crt" data-at=".72">
          <p class="kicker" data-fx="fade" data-a="0" data-d=".1">02 · Build</p>
          <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">Then a herd picks them up.</h2>
          <p class="lede" data-fx="reveal" data-a=".12" data-d=".36"><b>herdr</b> and <b>ntm</b> keep eight agent panes running side by side, each claiming a ready bead. I review, steer and merge. They type.</p>
          <p class="stat mono" data-fx="rise" data-a=".1" data-d=".1"><span data-merged>0</span>/8 merged</p>
          <div class="terms" data-hook="terms" style="margin-top:22px">
            {term.map(([n, task, status], i) => (
              <div class="term" data-i={i} data-task={task} data-status={status}><b>{n}</b><span class="line"></span></div>
            ))}
          </div>
        </div></div>
      </section>

      <!-- 3. FACEMORPH -->
      <section class="scene" data-scene="facemorph" data-len={S('facemorph').len} aria-label="facemorph.me">
        <div class="content split flip">
          <div class="duo" data-fx="tilt" data-a=".05" data-d=".5">
            <div class="browser"><div class="chrome"><i></i><i></i><i></i><span>facemorph.me</span></div><div class="shot"><img src={`${base}/shots/facemorph-d.jpg`} alt="The new facemorph.me: generate faces from words, seeds or photos, all on your device" loading="lazy" /></div></div>
            <div class="phone morphphone" data-fx="rise" data-a=".3" data-d=".2"><img src={`${base}/img/ghost/checkface/disconcerting-faces-gif.webp`} alt="An animated morph between generated faces" loading="lazy" /></div>
          </div>
          <div class="copy">
            <p class="kicker" data-fx="fade" data-a="0" data-d=".1">03 · facemorph.me</p>
            <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">A GPU server's job, now done by your phone.</h2>
            <p class="lede" data-fx="reveal" data-a=".16" data-d=".36">Type any words and <b>facemorph.me</b> turns them into a face that does not exist, then morphs smoothly to the next. It used to need a server with a GTX 1080. The new version runs <b>StyleGAN2 and encoder4editing entirely on your device</b>: nothing is uploaded, and the server can retire. The port was done with autoresearch loops: agents iterating against fidelity checks until the phone matched the server.</p>
            <div data-fx="rise" data-a=".28" data-d=".15"><span class="pill">StyleGAN2</span><span class="pill">on-device</span><span class="pill">autoresearch port</span></div>
            <a class="cta" data-fx="rise" data-a=".32" data-d=".15" href="https://next.facemorph.me">Try the preview</a>
          </div>
        </div>
      </section>

      <!-- 3. PHYSICAL SOCCER -->
      <section class="scene" data-scene="projects" id="projects" data-len={S('projects').len} aria-label="Physical Soccer">
        <div class="content split">
          <div class="copy">
            <p class="kicker" data-fx="fade" data-a="0" data-d=".1">04 · Physical Soccer</p>
            <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">Anything can be a controller.</h2>
            <p class="lede" data-fx="reveal" data-a=".18" data-d=".36">Host the match on the TV. Friends join with their phones, a keyboard, a pad, or half a touchscreen: <b>every button is its own player</b>. Each kickoff deals a new mix of footballers or forklifts, walker frames, rain and body quirks, and one button drives whatever you get. Twenty-two playtest rounds and counting.</p>
            <div data-fx="rise" data-a=".28" data-d=".15"><span class="pill">QR join</span><span class="pill">Forklift Football</span><span class="pill">Walker Ball</span><span class="pill">Spec Ops</span></div>
            <a class="cta" data-fx="rise" data-a=".32" data-d=".15" href="https://physicalsoccer.dilger.dev">physicalsoccer.dilger.dev</a>
          </div>
          <div class="duo" data-fx="tilt" data-a=".05" data-d=".5">
            <div class="browser"><div class="chrome"><i></i><i></i><i></i><span>physicalsoccer.dilger.dev</span></div><div class="shot"><img src={`${base}/shots/physicalsoccer-d.jpg`} alt="A Physical Soccer match: blocky red and blue footballers tangle near the ball in a cartoon stadium" loading="lazy" /></div></div>
            <div class="phone" data-fx="rise" data-a=".3" data-d=".2"><img src={`${base}/shots/physicalsoccer-m.jpg`} alt="The phone join screen: scan the host QR or enter a room code" loading="lazy" /></div>
          </div>
        </div>
      </section>

      <!-- 4. JAMMERS -->
      <section class="scene" data-scene="jammers" data-len={S('jammers').len} aria-label="Joystick Jammers">
        <div class="content split flip">
          <div class="duo" data-fx="tilt" data-a=".05" data-d=".5">
            <div class="browser"><div class="chrome"><i></i><i></i><i></i><span>jammers.dilger.dev</span></div><div class="shot tv" data-hook="tvon" data-at=".12"><img src={`${base}/shots/jammers-d.jpg`} alt="Comic-style low-poly cars racing on an outback track with mesas, a windmill and bunting" loading="lazy" /></div></div>
            <div class="phone" data-fx="rise" data-a=".3" data-d=".2"><img src={`${base}/shots/jammers-poc-m.jpg`} alt="The phone controller: drive and action thumbsticks, boost bar and lap position" loading="lazy" /></div>
          </div>
          <div class="copy">
            <p class="kicker" data-fx="fade" data-a="0" data-d=".1">05 · Joystick Jammers</p>
            <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">The TV is the arena. Phones are the pads.</h2>
            <p class="lede" data-fx="reveal" data-a=".18" data-d=".36">A party racer and demolition derby for <b>sixteen-plus players</b>. Open a room, scan the QR, race before the couch gets cold. The new version takes it to the outback: ink outlines, halftone shading and red dirt, split-screen on the TV, twin sticks on your phone. No installs.</p>
            <a class="cta" data-fx="rise" data-a=".3" data-d=".15" href="https://jammers.dilger.dev">jammers.dilger.dev</a>
          </div>
        </div>
      </section>

      <!-- 5. BOOKS -->
      <section class="scene" data-scene="books" data-len={S('books').len} aria-label="Aviation ABCs">
        <div class="content split">
          <div class="copy">
            <p class="kicker" data-fx="fade" data-a="0" data-d=".1">06 · Dilger Books</p>
            <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">26 letters. 26 flying machines.</h2>
            <p class="lede" data-fx="reveal" data-a=".18" data-d=".36"><b>Aviation ABCs</b>, written by Daniel Dilger and published by me: a 20 × 20 cm hardcover picture book from Air Tractor to Zero, printed to order. Its own storefront, page-by-page peek inside, and Stripe checkout. A little book with a big sky.</p>
            <a class="cta" data-fx="rise" data-a=".3" data-d=".15" href="https://books.dilger.au">books.dilger.au</a>
          </div>
          <div class="duo" data-fx="tilt" data-a=".05" data-d=".5">
            <div class="browser"><div class="chrome"><i></i><i></i><i></i><span>books.dilger.au</span></div><div class="shot"><img data-fx="pan" src={`${base}/shots/books-d.jpg`} alt="Aviation ABCs storefront" loading="lazy" /></div></div>
            <div class="phone" data-fx="rise" data-a=".3" data-d=".2"><img src={`${base}/shots/books-m.jpg`} alt="Aviation ABCs on a phone" loading="lazy" /></div>
          </div>
        </div>
      </section>

      <!-- 6. DISHMATE -->
      <section class="scene" data-scene="dishmate" data-len={S('dishmate').len} aria-label="Dishmate">
        <div class="content split flip">
          <div class="duo" data-fx="tilt" data-a=".05" data-d=".5">
            <div class="browser"><div class="chrome"><i></i><i></i><i></i><span>dishmate</span></div><div class="shot"><img data-fx="pan" src={`${base}/shots/dishmate-d.jpg`} alt="Dishmate load advisor: pick what is in the load, the soil type and water hardness" loading="lazy" /></div></div>
            <div class="phone" data-fx="rise" data-a=".3" data-d=".2"><img src={`${base}/shots/dishmate-m.jpg`} alt="Dishmate on a phone" loading="lazy" /></div>
          </div>
          <div class="copy">
            <p class="kicker" data-fx="fade" data-a="0" data-d=".1">07 · Dishmate</p>
            <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">Small tools that solve a real annoyance.</h2>
            <p class="lede" data-fx="reveal" data-a=".18" data-d=".36"><b>Dishmate</b> is a set of dishwasher decision trees: a load advisor, a troubleshooter for cloudy glasses and white film, and advice on detergent, rinse aid and hard water. A dependency-free TypeScript library with an offline-capable demo. (Spoiler: use powder, run the hot tap first, and stop pre-rinsing.)</p>
            <a class="cta" data-fx="rise" data-a=".3" data-d=".15" href="https://cdilga.github.io/dishmate/">Try the demo</a>
          </div>
        </div>
      </section>

      <!-- 7. HOME TWIN -->
      <section class="scene" data-scene="home" data-len={S('home').len} aria-label="Home digital twin">
        <div class="content split">
          <div class="copy">
            <p class="kicker" data-fx="fade" data-a="0" data-d=".1">08 · House twin (private)</p>
            <h2 class="mid" data-fx="words" data-a=".02" data-d=".3">A digital twin of a real house, from the drawings.</h2>
            <p class="lede" data-fx="reveal" data-a=".15" data-d=".36">Walk the model and its street, switch between <b>slab</b>, <b>frame</b> and <b>finished</b>, mark where the power points should go, and drive a ute and trailer down the side to check it fits, and turn any view into a photographic garden visualisation. It is generated from code, so every element has a stable ID and changes show up as diffs. Rust and Bevy on WebGPU, in the browser. It stays private: a model this detailed would give away where we live.</p>
            <div data-fx="rise" data-a=".2" data-d=".15"><span class="pill" data-stage="slab">slab</span><span class="pill" data-stage="frame">frame</span><span class="pill" data-stage="finished">finished</span></div>
            <a class="cta" data-fx="rise" data-a=".28" data-d=".15" href={`${base}/blog/home-digital-twin/`}>How it works</a>
          </div>
          <div class="duo homeduo" data-fx="tilt" data-a=".05" data-d=".5">
            <div class="browser"><div class="chrome"><i></i><i></i><i></i><span>private viewer</span></div><div class="shot morph"><img src={`${base}/shots/home-street-model.jpg`} alt="The house twin from across the street: the generated model with stand-in trees" loading="lazy" /><img class="morph-to" data-fx="fade" data-a=".42" data-d=".2" src={`${base}/shots/home-street-muse.jpg`} alt="The same camera pose turned into a photographic garden visualisation by an image model" loading="lazy" /><span class="morph-tag mono" data-fx="out" data-a=".42" data-d=".12">engine frame</span><span class="morph-tag mono" data-fx="fade" data-a=".5" data-d=".12">AI visualisation · draft proposal</span></div></div>
            <svg viewBox="0 0 520 340" class="house inset" role="img" aria-label="House model moving from slab to frame to finished" data-hook="house">
            <defs><linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a1a12" /><stop offset="1" stop-color="#120d0a" /></linearGradient></defs>
            <rect width="520" height="340" rx="16" fill="url(#sky)" stroke="rgba(242,230,211,.18)" />
            <path d="M30 270 L260 310 L490 270 L260 230 Z" fill="#2c1e15" stroke="rgba(242,230,211,.25)" />
            <g class="slab"><path d="M120 262 L260 290 L400 262 L260 234 Z" fill="#6b5846" /><path d="M120 262 L260 290 L260 300 L120 272 Z" fill="#4c3d30" /><path d="M260 290 L400 262 L400 272 L260 300 Z" fill="#574736" /></g>
            <g class="frame" fill="none" stroke="#ff9a4d" stroke-width="2">
              {[0, 1, 2, 3, 4, 5].map((i) => <line x1={130 + i * 24} y1={256 - i * 5.6} x2={130 + i * 24} y2={176 - i * 5.6} />)}
              {[0, 1, 2, 3, 4, 5].map((i) => <line x1={270 + i * 24} y1={286 - i * 5.6 - 28} x2={270 + i * 24} y2={206 - i * 5.6 - 28} />)}
              <path d="M120 176 L260 204 L400 176 M120 176 L260 148 L400 176 M260 148 L260 204" />
            </g>
            <g class="finished">
              <path d="M120 262 L260 290 L260 200 L120 172 Z" fill="#d9c4a4" /><path d="M260 290 L400 262 L400 172 L260 200 Z" fill="#b89f7c" />
              <path d="M110 176 L260 142 L410 176 L260 206 Z" fill="#8a3b1d" /><path d="M110 176 L260 206 L260 218 L110 188 Z" fill="#5d2813" />
              <rect x="150" y="204" width="34" height="30" fill="#2e4150" transform="skewY(11)" /><rect x="296" y="242" width="38" height="34" fill="#2e4150" transform="skewY(-11)" />
            </g>
            <g class="marks">{[[200, 232], [330, 244], [276, 256]].map(([x, y], i) => <g data-i={i}><circle cx={x} cy={y} r="7" fill="#ff7a1a" /><circle cx={x} cy={y} r="14" fill="none" stroke="#ff7a1a" stroke-opacity=".5" /></g>)}</g>
            <text class="stagelabel" x="28" y="44" fill="#f2e6d3" font-size="15" font-family="JetBrains Mono, monospace">SLAB</text>
          </svg>
          </div>
        </div>
      </section>

      <!-- 8. WRITING: rotary carousel -->
      <section class="scene" data-scene="writing" data-len={S('writing').len} aria-label="Writing">
        <div class="bg sandvid" aria-hidden="true"><video muted loop playsinline preload="none" poster={`${base}/video/windswept-poster.jpg`} data-src-webm={`${base}/video/windswept.webm`} data-src-mp4={`${base}/video/windswept.mp4`}></video></div>
        <div class="content wheelwrap">
          <p class="kicker" data-fx="fade" data-a="0" data-d=".06">09 · Writing</p>
          <h2 class="mid" data-fx="words" data-a=".01" data-d=".12">Notes with the workings shown.</h2>
          <p class="wheel-hint mono" data-fx="fade" data-a=".08" data-d=".08">scroll or drag to turn · {allPosts.length} posts</p>
          <div class="wheel" data-hook="wheel" role="list" aria-label="All posts, newest first">
            {allPosts.map((p) => (
              <a class={`wcard${p.data.legacy ? ' old' : ''}`} role="listitem" href={`${base}/blog/${p.id}/`} draggable="false">
                <span class="wimg">{p.data.image ? <img src={img(p.data.image)} alt="" loading="lazy" draggable="false" /> : <i aria-hidden="true"></i>}</span>
                <small>{p.data.date.toISOString().slice(0, 10)}{p.data.legacy ? ' · archive' : ''}</small>
                <b>{p.data.title}</b>
              </a>
            ))}
          </div>
          <a class="cta ghost wheel-all" data-fx="rise" data-a=".1" data-d=".1" href={`${base}/blog/`}>All posts</a>
        </div>
      </section>

      <!-- 9. CONTACT -->
      <section class="scene" data-scene="contact" data-bg="b" data-bg-dim=".45" data-len={S('contact').len} aria-label="Contact">
        <div class="content" style="text-align:center">
          <h2 class="big" data-fx="words" data-a=".02" data-d=".35">Say hello.</h2>
          <p class="lede" style="margin-inline:auto" data-fx="reveal" data-a=".2" data-d=".36">Building something with agents, games or models of real places? I like talking about it.</p>
          <div data-fx="rise" data-a=".3" data-d=".2">
            <a class="cta" href="https://github.com/cdilga">GitHub</a>
            <a class="cta ghost" href="https://x.com/cdilga">X</a>
            <a class="cta ghost" href="https://linkedin.com/in/cdilga">LinkedIn</a>
            <a class="cta ghost" href="https://youtube.com/@cdilga">YouTube</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
<footer class="foot">© Chris Dilger · Built with Astro, beads and a herd of agents.</footer>
<script>import "../scripts/story.js"; import "../scripts/story-bg.js";</script>
</Base>
