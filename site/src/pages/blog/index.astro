---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Writing | Chris Dilger">
  <div class="list">
    <h1>Writing</h1>
    <div class="cards" style="grid-template-columns:1fr">
      {posts.map((p) => <a class="card" href={`${base}/blog/${p.id}/`}><small>{p.data.date.toISOString().slice(0, 10)}</small><h3>{p.data.title}</h3><p>{p.data.description}</p></a>)}
    </div>
  </div>
  <footer class="foot">© Chris Dilger</footer>
</Base>
