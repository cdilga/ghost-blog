#!/usr/bin/env bash
# Write and publish chris.dilger.me from the terminal.
#
#   ./blog setup                 install what the site needs (once per machine)
#   ./blog new "Post title"      start a draft post (add --mdx for charts and components)
#   ./blog dev                   live preview at http://localhost:4321 (drafts included)
#   ./blog check                 build the site exactly as Cloudflare will
#   ./blog preview ["message"]   commit, build and push to main -> https://chris-preview.dilger.me
#   ./blog status                what is on the preview site but not yet live
#   ./blog promote [commit]      put what is on preview live -> https://chris.dilger.me
#
# Hosting is Cloudflare Pages: every push to main rebuilds the preview site, and moving the prod branch
# rebuilds production. Nothing here needs Cloudflare credentials.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SITE="$ROOT/site"
PREVIEW_URL=https://chris-preview.dilger.me
PROD_URL=https://chris.dilger.me

say() { printf '\033[1;33m%s\033[0m\n' "$*"; }
die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }

need_deps() { [ -d "$SITE/node_modules" ] || die "Run ./blog setup first."; }

cmd_setup() {
  command -v git >/dev/null || die "Install git first."
  command -v node >/dev/null || die "Install Node.js 22 (https://nodejs.org, or 'brew install node@22', or nvm) and run this again."
  local major; major=$(node -p 'process.versions.node.split(".")[0]')
  [ "$major" -ge 20 ] || die "Node $major is too old: install Node.js 22 and run this again."
  say "Installing the site's packages..."
  (cd "$SITE" && npm ci --no-audit --no-fund)
  if command -v gh >/dev/null; then
    gh auth status >/dev/null 2>&1 || say "Optional: run 'gh auth login' so './blog promote' can use the Promote workflow."
  else
    say "Optional: install the GitHub CLI (https://cli.github.com) for './blog promote'. Without it, promote pushes the prod branch directly."
  fi
  say "Done. Try: ./blog new \"My first post\" then ./blog dev"
}

cmd_new() {
  local mdx=0 title=""
  for a in "$@"; do case "$a" in --mdx) mdx=1 ;; *) title="${title:+$title }$a" ;; esac; done
  [ -n "$title" ] || die 'Usage: ./blog new "Post title" [--mdx]'
  local slug; slug=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
  local ext=md; [ $mdx = 1 ] && ext=mdx
  local file="$SITE/src/content/blog/$slug.$ext"
  [ -e "$SITE/src/content/blog/$slug.md" ] || [ -e "$SITE/src/content/blog/$slug.mdx" ] && die "A post called $slug already exists."
  mkdir -p "$SITE/public/img/$slug"
  {
    printf -- '---\ntitle: "%s"\ndescription: "One or two sentences for search results, link previews and the post list."\n' "${title//\"/\\\"}"
    printf 'date: %s\ntags: []\n# image: /img/%s/cover.jpg\ndraft: true\n---\n' "$(date +%F)" "$slug"
    if [ $mdx = 1 ]; then
      printf "import Chart from '../../components/Chart.astro';\n\n"
      printf 'Start writing here.\n\n<Chart type="line" title="Example" series={[{ name: "a", data: [[0, 1], [1, 3], [2, 2]] }]} xLabel="x" yLabel="y" caption="Delete me." />\n'
    else
      printf 'Start writing here.\n\n![Describe the picture](/img/%s/example.jpg)\n' "$slug"
    fi
  } > "$file"
  say "Created ${file#"$ROOT/"}"
  say "Images go in site/public/img/$slug/ and are linked as /img/$slug/<file>."
  say "It is a draft: hidden from lists, feeds and search, never built for production. Set draft: false to publish."
  [ -n "${EDITOR:-}" ] && "$EDITOR" "$file" || true
}

cmd_dev() { need_deps; cd "$SITE" && exec npm run dev; }

cmd_check() {
  need_deps
  say "Building the site (first build encodes images and search embeddings, so it can take a minute)..."
  (cd "$SITE" && SITE="$PROD_URL" BASE=/ npm run build)
  say "Build OK."
}

cmd_preview() {
  local msg="${1:-}"
  local branch; branch=$(git -C "$ROOT" branch --show-current)
  [ "$branch" = main ] || die "Switch to main first (git switch main). You are on '$branch'."
  git -C "$ROOT" pull --rebase --autostash origin main
  cmd_check   # also refreshes site/search-cache.json, which is committed
  if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
    git -C "$ROOT" status --short
    [ -n "$msg" ] || read -r -p "Commit message: " msg
    [ -n "$msg" ] || die "Need a commit message."
    git -C "$ROOT" add -A
    git -C "$ROOT" commit -m "$msg"
  fi
  git -C "$ROOT" push origin main
  say "Pushed. $PREVIEW_URL updates in about two minutes. When it looks right: ./blog promote"
}

cmd_status() {
  git -C "$ROOT" fetch -q origin main prod
  local n; n=$(git -C "$ROOT" rev-list --count origin/prod..origin/main)
  if [ "$n" = 0 ]; then say "Production is up to date with the preview site."; return; fi
  say "$n commit(s) on the preview site that are not live yet:"
  git -C "$ROOT" log --oneline origin/prod..origin/main
}

cmd_promote() {
  local ref="${1:-main}"
  git -C "$ROOT" fetch -q origin main prod
  local target; target=$(git -C "$ROOT" rev-parse "origin/$ref" 2>/dev/null || git -C "$ROOT" rev-parse "$ref")
  git -C "$ROOT" merge-base --is-ancestor origin/prod "$target" \
    || die "prod is not an ancestor of $ref. Refusing to rewrite production history."
  if [ "$(git -C "$ROOT" rev-parse origin/prod)" = "$target" ]; then say "Already live."; return; fi
  say "Going live:"
  git -C "$ROOT" log --oneline "origin/prod..$target"
  read -r -p "Promote these to $PROD_URL? [y/N] " ok
  [ "$ok" = y ] || [ "$ok" = Y ] || die "Cancelled."
  if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    gh workflow run promote.yml -R cdilga/ghost-blog -f ref="$target"
    say "Promote workflow started (gh run watch -R cdilga/ghost-blog to follow it)."
  else
    git -C "$ROOT" push origin "$target:refs/heads/prod"
  fi
  say "$PROD_URL updates in about two minutes. To undo, use Rollback on an older production deployment in Cloudflare (Workers & Pages > chris-dilger-me > Deployments)."
}

case "${1:-help}" in
  setup) shift; cmd_setup "$@" ;;
  new) shift; cmd_new "$@" ;;
  dev) shift; cmd_dev ;;
  check|build) shift; cmd_check ;;
  preview) shift; cmd_preview "$@" ;;
  status) shift; cmd_status ;;
  promote) shift; cmd_promote "$@" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
